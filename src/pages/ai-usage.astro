---
const baseUrl = import.meta.env.BASE_URL;
const base = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <title>AI Transparency | Patrick Paul</title>
    <script is:inline define:vars={{ base }}>
      let stored;
      try {
        stored = localStorage.getItem('portfolio-language');
      } catch {
        // Fall back to the browser language when storage is unavailable.
      }
      const storedPreference = stored === 'en' || stored === 'fr' ? stored : null;
      const browserPrefersFrench = navigator.languages?.some((language) => language.toLowerCase().startsWith('fr'))
        ?? navigator.language?.toLowerCase().startsWith('fr')
        ?? false;
      const preferred = storedPreference ?? (browserPrefersFrench ? 'fr' : 'en');
      window.location.replace(`${base}${preferred}/ai-usage/`);
    </script>
    <noscript><meta http-equiv="refresh" content="0; url=../en/ai-usage/" /></noscript>
  </head>
  <body>
    <p><a href="../en/ai-usage/">Continue in English</a> · <a href="../fr/ai-usage/">Continuer en français</a></p>
  </body>
</html>
