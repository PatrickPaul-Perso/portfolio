---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang: 'en' | 'fr';
}

const { title, description, lang } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const base = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
const alternateLang = lang === 'en' ? 'fr' : 'en';
const alternateLabel = lang === 'en' ? 'Français' : 'English';
const disclosure = lang === 'en'
  ? 'Generative AI was used as an engineering and writing assistant in the production of this website. All published content and technical decisions were reviewed and approved by Patrick Paul.'
  : 'L’IA générative a servi d’assistante à l’ingénierie et à la rédaction de ce site Web. Patrick Paul a révisé et approuvé l’ensemble du contenu publié et des décisions techniques.';
const transparencyLabel = lang === 'en' ? 'AI transparency' : 'Transparence sur l’IA';
const skipLabel = lang === 'en' ? 'Skip to main content' : 'Aller au contenu principal';
const languageNavLabel = lang === 'en' ? 'Language selection' : 'Choix de la langue';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{skipLabel}</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="site-name" href={`${base}${lang}/`}>Patrick Paul</a>
        <nav aria-label={languageNavLabel}>
          <a class="language-link" href={`${base}${alternateLang}/`} hreflang={alternateLang} data-language={alternateLang}>{alternateLabel}</a>
        </nav>
      </div>
    </header>
    <slot />
    <footer>
      <p class="notice">
        {disclosure}
      </p>
      <p><a href={`${base}ai-usage/`}>{transparencyLabel}</a></p>
    </footer>
    <script>
      document.querySelectorAll<HTMLAnchorElement>('[data-language]').forEach((link) => {
        link.addEventListener('click', () => {
          const language = link.dataset.language;
          if (!language) return;

          try {
            localStorage.setItem('portfolio-language', language);
          } catch {
            // Navigation still works when storage is unavailable.
          }
        });
      });
    </script>
  </body>
</html>

<style>
  .skip-link { position: fixed; top: .75rem; left: .75rem; z-index: 20; padding: .7rem 1rem; border-radius: .5rem; background: var(--text); color: var(--background); font-weight: 800; transform: translateY(-180%); }
  .skip-link:focus { transform: translateY(0); }
  .site-header { width: min(1180px, calc(100% - 2rem)); margin-inline: auto; padding-top: 1.25rem; }
  .header-inner { min-height: 3.5rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; border-bottom: 1px solid var(--border); }
  .site-name, .language-link { min-height: 44px; display: inline-flex; align-items: center; text-decoration: none; }
  .site-name { color: var(--text); font-weight: 800; letter-spacing: -.02em; }
  .language-link { padding-inline: .75rem; }
</style>
